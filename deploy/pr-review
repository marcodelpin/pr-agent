#!/usr/bin/env bash
# pr-review - Local code review client
# =====================================
# Reviews code changes using PR-Agent on mdp-gpu
#
# Installation:
#   ln -s /path/to/pr-agent/deploy/pr-review ~/.local/bin/pr-review
#
# Usage:
#   pr-review                     # Review uncommitted changes
#   pr-review HEAD~3              # Review last 3 commits
#   pr-review main..feature       # Review branch diff
#   pr-review --improve           # Get improvement suggestions
#   pr-review --describe          # Generate PR description
#
# Examples:
#   pr-review                     # Review staged + unstaged changes
#   pr-review HEAD~1              # Review last commit
#   pr-review origin/main..HEAD   # Review all commits since main

set -euo pipefail

# Configuration
PR_REVIEW_URL="${PR_REVIEW_URL:-https://pr-review.mdp}"
CURL_OPTS="-sk"  # Silent, allow self-signed certs

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

usage() {
    cat << 'EOF'
pr-review - AI-powered local code review

Usage:
    pr-review [OPTIONS] [REVISION_RANGE]

Options:
    -h, --help       Show this help
    -i, --improve    Get code improvement suggestions
    -d, --describe   Generate PR description
    -m, --model MODEL  Use specific model (e.g., ollama/qwen2.5-coder:32b)
    --health         Check server health
    --models         List available models

Revision Range:
    (none)           Review uncommitted changes (staged + unstaged)
    HEAD~N           Review last N commits
    main..HEAD       Review commits since main
    commit1..commit2 Review range between commits

Examples:
    pr-review                          # Review current changes
    pr-review HEAD~1                   # Review last commit
    pr-review origin/main..HEAD        # Review feature branch
    pr-review --improve HEAD~1         # Get suggestions for last commit
    pr-review -m ollama/qwen2.5-coder:32b   # Use specific model

Environment:
    PR_REVIEW_URL    Server URL (default: https://pr-review.mdp)
EOF
}

check_health() {
    echo -e "${BLUE}Checking server health...${NC}"
    response=$(curl $CURL_OPTS "$PR_REVIEW_URL/health" 2>/dev/null)
    if [[ $? -eq 0 ]]; then
        echo "$response" | jq -r '
            "Status: \(.status)",
            "Ollama: \(.ollama)",
            "Model: \(.default_model)"
        ' 2>/dev/null || echo "$response"
    else
        echo -e "${RED}Error: Cannot connect to $PR_REVIEW_URL${NC}"
        exit 1
    fi
}

list_models() {
    echo -e "${BLUE}Available coding models:${NC}"
    curl $CURL_OPTS "$PR_REVIEW_URL/models" 2>/dev/null | \
        jq -r '.coding_models[]' 2>/dev/null | head -20
}

# Parse arguments
COMMAND="review"
MODEL=""
REVISION=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            usage
            exit 0
            ;;
        -i|--improve)
            COMMAND="improve"
            shift
            ;;
        -d|--describe)
            COMMAND="describe"
            shift
            ;;
        -m|--model)
            MODEL="$2"
            shift 2
            ;;
        --health)
            check_health
            exit 0
            ;;
        --models)
            list_models
            exit 0
            ;;
        -*)
            echo -e "${RED}Unknown option: $1${NC}"
            usage
            exit 1
            ;;
        *)
            REVISION="$1"
            shift
            ;;
    esac
done

# Verify we're in a git repo
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo -e "${RED}Error: Not in a git repository${NC}"
    exit 1
fi

# Get the diff
echo -e "${BLUE}Getting diff...${NC}"
if [[ -z "$REVISION" ]]; then
    # Uncommitted changes (staged + unstaged)
    DIFF=$(git diff HEAD 2>/dev/null || git diff)
    if [[ -z "$DIFF" ]]; then
        # Try just staged
        DIFF=$(git diff --cached)
    fi
    DIFF_DESC="uncommitted changes"
else
    DIFF=$(git diff "$REVISION")
    DIFF_DESC="$REVISION"
fi

if [[ -z "$DIFF" ]]; then
    echo -e "${YELLOW}No changes to review${NC}"
    exit 0
fi

# Count changes
LINES_ADDED=$(echo "$DIFF" | grep -c '^+[^+]' || true)
LINES_REMOVED=$(echo "$DIFF" | grep -c '^-[^-]' || true)
FILES_CHANGED=$(echo "$DIFF" | grep -c '^diff --git' || true)

echo -e "${GREEN}Reviewing $DIFF_DESC${NC}"
echo -e "  Files: $FILES_CHANGED, Lines: +$LINES_ADDED/-$LINES_REMOVED"
echo ""

# Build endpoint URL
ENDPOINT="$PR_REVIEW_URL/$COMMAND/raw"
if [[ -n "$MODEL" ]]; then
    ENDPOINT="$ENDPOINT?model=$MODEL"
fi

# Send for review
echo -e "${BLUE}Sending to $PR_REVIEW_URL ($COMMAND)...${NC}"
echo ""

RESPONSE=$(echo "$DIFF" | curl $CURL_OPTS -X POST "$ENDPOINT" \
    -H "Content-Type: text/plain" \
    -d @- 2>/dev/null)

if [[ $? -ne 0 ]]; then
    echo -e "${RED}Error: Failed to connect to server${NC}"
    exit 1
fi

# Display response
echo -e "${GREEN}=== Review Results ===${NC}"
echo ""
echo "$RESPONSE"
